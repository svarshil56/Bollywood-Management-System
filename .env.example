# Database configuration

# Option A: Cloud Connection String (Recommended for Neon.tech, Supabase, etc.)
# Copy-paste your Neon connection string here
DATABASE_URL=postgresql://your_user:your_password@ep-snowflake-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual Connection Variables (For local PostgreSQL)
DB_USER=your_local_user
DB_HOST=localhost
DB_NAME=bollywood_db
DB_PASS=your_local_password
DB_PORT=5432

# Server configuration
PORT=3000

